# Production entry point: HTTPS termination, static PWA, and reverse proxy
# to the backend API and Martin's vector tiles -- see despliegue/README.md.
#
# {$DOMAIN} is a plain domain (e.g. reporteec.example.com) in real
# deployments, which Caddy fronts with automatic HTTPS (Let's Encrypt).
# For a local smoke test, override it with a scheme + port
# (e.g. DOMAIN=http://localhost:8088) and Caddy serves plain HTTP instead;
# DOMAIN=localhost also works and uses Caddy's internal CA for HTTPS.
{$DOMAIN} {
	encode zstd gzip

	# Applies to every response below, including the reverse-proxied ones.
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		# 'self' covers /api and /tiles (same origin through this Caddyfile).
		# MapLibre GL starts its own worker from a blob: URL (see
		# frontend/src/lib/maplibreWorker.ts) and the basemap fetches
		# OpenFreeMap's vector tiles/glyphs directly from the browser (see
		# frontend/src/lib/basemap.ts) -- both are allowed explicitly below.
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src 'self' https://tiles.openfreemap.org; worker-src 'self' blob:; font-src 'self' https://tiles.openfreemap.org data:; manifest-src 'self'; base-uri 'none'; frame-ancestors 'none'"
	}

	# Martin's tiles. handle_path strips the /tiles prefix before proxying,
	# so martin.prod.yaml sets base_path: /tiles to keep its own TileJSON
	# responses' URLs correct for callers that read them (the frontend
	# builds tile URLs itself -- see frontend/src/components/IncidentMap.tsx
	# -- so this mostly matters for direct catalog/TileJSON inspection).
	handle_path /tiles/* {
		reverse_proxy martin:3000
	}

	handle /api/* {
		reverse_proxy backend:8000
	}

	handle /health {
		reverse_proxy backend:8000
	}

	# Everything else: the built PWA (see codigo/despliegue/Caddy.Dockerfile),
	# with a client-side-router fallback to index.html.
	handle {
		root * /srv

		@hashed path /assets/*
		header @hashed Cache-Control "public, max-age=31536000, immutable"

		# Must always be revalidated: the entry HTML (so a new deploy is
		# picked up at all), and the service worker + its registration +
		# manifest (a stale copy of any of these can pin a visitor to an old
		# build indefinitely).
		@no_cache path /index.html /sw.js /registerSW.js /manifest.webmanifest
		header @no_cache Cache-Control "no-cache"

		try_files {path} /index.html
		file_server
	}
}
